{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "../../shared/tah-runtime",
    "paths": {
      "zod": [
        "vendor/zod/index.d.ts"
      ]
    },
    "types": [
      "node"
    ],
    "typeRoots": [
      "./node_modules/@types"
    ]
  },
  "include": [
    "../../shared/tah-runtime/platform/**/*.ts"
  ]
}
