+#[tokio::test]
+async fn already_cancelled_request_does_not_start_a_process() {
+    let (env, backend, params) = setup(vec![]);
+    let cancellation = CancellationToken::new();
+    cancellation.cancel();
+    let result = execute_embedded_command(&env, params, ExecExpiration::Cancellation(cancellation),
+        ExecCapturePolicy::ShellTool, None, None).await.unwrap();
+    assert_eq!(result.exit_code, 1);
+    assert_eq!(backend.starts.load(Ordering::SeqCst), 0);
+}
