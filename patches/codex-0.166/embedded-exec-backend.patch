diff --git a/codex-rs/exec-server/src/environment/embedded.rs b/codex-rs/exec-server/src/environment/embedded.rs
new file mode 100644
--- /dev/null
+++ b/codex-rs/exec-server/src/environment/embedded.rs
@@ -0,0 +1,139 @@
+//! Host-owned embedded executor registration. No native process or filesystem fallback.
+
+use super::*;
+use crate::EnvironmentCapabilities;
+
+pub const EMBEDDED_ENVIRONMENT_ID: &str = "embedded";
+
+impl Environment {
+    /// Bundles an already initialized, trusted embedded executor and filesystem.
+    ///
+    /// Both providers must enforce every request's sandbox/network policy, or
+    /// return an error before performing any operation. This constructor does
+    /// not turn an arbitrary implementation into a security boundary. The
+    /// supplied metadata describes the guest, never `EnvironmentInfo::local()`.
+    /// HTTP remains host-owned and uses the caller's effective outbound policy.
+    ///
+    /// This initial integration supports baseline exec/filesystem operations.
+    /// Capability extensions (including snapshots and config discovery) are
+    /// rejected rather than falling back to host implementations.
+    pub fn embedded(
+        exec_backend: Arc<dyn ExecBackend>,
+        filesystem: Arc<dyn ExecutorFileSystem>,
+        info: EnvironmentInfo,
+        http_client_factory: HttpClientFactory,
+    ) -> Result<Self, ExecServerError> {
+        if info.capabilities != EnvironmentCapabilities::default() {
+            return Err(ExecServerError::Protocol(
+                "embedded executor capability extensions are not supported".into(),
+            ));
+        }
+        if info.cwd.is_none() || info.shell.path.is_empty() || info.platform_os.is_none() {
+            return Err(ExecServerError::Protocol(
+                "embedded executor must report its cwd, shell and platform".into(),
+            ));
+        }
+        Ok(Self {
+            skills: ScopedSkillsConfig::default(),
+            remote_client: None,
+            embedded_info: Some(info),
+            ready_info: Arc::new(ArcSwapOption::empty()),
+            provisioning_status_tx: None,
+            startup_task: Arc::new(Mutex::new(None)),
+            exec_backend,
+            filesystem,
+            http_client: Arc::new(RouteAwareHttpClient::new(http_client_factory)),
+            local_runtime_paths: None,
+        })
+    }
+
+    /// An in-process executor with its own process/filesystem boundary.
+    pub fn is_embedded(&self) -> bool {
+        self.embedded_info.is_some()
+    }
+
+    /// Whether command preparation and execution belong to the supplied backend,
+    /// rather than host-native spawning. This does not imply remote networking.
+    pub fn uses_exec_backend(&self) -> bool {
+        self.is_remote() || self.is_embedded()
+    }
+}
+
+impl EnvironmentManager {
+    /// Creates a fresh manager whose only/default environment is embedded.
+    /// No native `local` environment is registered. The embedded entry cannot
+    /// later be replaced through remote registration APIs. Thread policy and
+    /// app-server's embedded network policy must still be supplied by the host.
+    pub fn from_embedded(
+        exec_backend: Arc<dyn ExecBackend>,
+        filesystem: Arc<dyn ExecutorFileSystem>,
+        info: EnvironmentInfo,
+        http_client_factory: HttpClientFactory,
+    ) -> Result<Self, ExecServerError> {
+        let environment = Arc::new(Environment::embedded(
+            exec_backend,
+            filesystem,
+            info,
+            http_client_factory.clone(),
+        )?);
+        Ok(Self {
+            default_environment: Some(EMBEDDED_ENVIRONMENT_ID.into()),
+            environments: RwLock::new(HashMap::from([(
+                EMBEDDED_ENVIRONMENT_ID.into(), environment,
+            )])),
+            local_environment: None,
+            local_runtime_paths: None,
+            http_client_factory,
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn info() -> EnvironmentInfo {
+        let mut info = EnvironmentInfo::local();
+        info.capabilities = EnvironmentCapabilities::default();
+        info
+    }
+
+    #[tokio::test]
+    async fn embedded_registration_preserves_identity_and_has_no_native_fallback() {
+        // Real host providers are used only to test dependency injection identity.
+        let native = Environment::default_for_tests();
+        let backend = native.get_exec_backend();
+        let filesystem = native.get_filesystem();
+        let expected_info = info();
+        let manager = EnvironmentManager::from_embedded(
+            Arc::clone(&backend), Arc::clone(&filesystem), expected_info.clone(),
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+        ).unwrap();
+        let environment = manager.default_environment().unwrap();
+        assert!(environment.is_embedded());
+        assert!(environment.uses_exec_backend());
+        assert!(!environment.is_remote());
+        assert!(manager.try_local_environment().is_none());
+        assert!(manager.get_environment(LOCAL_ENVIRONMENT_ID).is_none());
+        assert!(environment.local_runtime_paths().is_none());
+        assert!(Arc::ptr_eq(&backend, &environment.get_exec_backend()));
+        assert!(Arc::ptr_eq(&filesystem, &environment.get_filesystem()));
+        assert_eq!(environment.info().await.unwrap(), expected_info);
+        assert_eq!(environment.force_info().await.unwrap(), expected_info);
+        assert!(manager.upsert_environment(
+            EMBEDDED_ENVIRONMENT_ID.into(), "ws://127.0.0.1:1".into(), None,
+        ).is_err());
+        assert!(Arc::ptr_eq(&environment, &manager.default_environment().unwrap()));
+    }
+
+    #[test]
+    fn embedded_rejects_host_capability_claims() {
+        let native = Environment::default_for_tests();
+        let mut info = info();
+        info.capabilities.environment_config_read = true;
+        assert!(Environment::embedded(native.get_exec_backend(), native.get_filesystem(), info,
+            HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)).is_err());
+        assert!(!native.is_embedded());
+        assert!(!native.uses_exec_backend());
+    }
+}
