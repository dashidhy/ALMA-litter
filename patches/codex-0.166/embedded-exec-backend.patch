+//! Direct, already-authorized one-shot capture over an embedded process handle.
+//! Model tools use unified exec's existing lifecycle instead of this entry point.
+
+use super::*;
+use codex_exec_server::Environment;
+use codex_exec_server::ExecOutputStream as BackendStream;
+use codex_exec_server::ExecProcess;
+use codex_exec_server::ExecServerError;
+use std::sync::Arc;
+
+struct TerminateOnDrop(Option<Arc<dyn ExecProcess>>);
+
+impl Drop for TerminateOnDrop {
+    fn drop(&mut self) {
+        if let Some(process) = self.0.take() {
+            // Drop cannot await confirmation. Explicit timeout/cancel/error paths
+            // below do await it; the embedding host must keep Tokio alive for cleanup.
+            tokio::spawn(async move {
+                if let Err(error) = process.terminate().await {
+                    tracing::warn!("embedded process cleanup failed: {error}");
+                }
+            });
+        }
+    }
+}
+
+fn backend_error(error: ExecServerError) -> CodexErr {
+    CodexErr::Io(io::Error::other(error))
+}
+
+#[derive(Default)]
+struct Capture {
+    stdout: Vec<u8>,
+    stderr: Vec<u8>,
+    stdout_deltas: usize,
+    stderr_deltas: usize,
+    exit_code: Option<i32>,
+    sandbox_denied: bool,
+}
+
+impl Capture {
+    async fn collect(
+        &mut self,
+        process: &dyn ExecProcess,
+        policy: ExecCapturePolicy,
+        stream: Option<&StdoutStream>,
+    ) -> Result<()> {
+        let mut after_seq = None;
+        let mut drain_deadline = None;
+        loop {
+            let read = process.read(after_seq, Some(READ_CHUNK_SIZE), Some(1000));
+            let page = match drain_deadline {
+                Some(deadline) => tokio::time::timeout_at(deadline, read)
+                    .await
+                    .map_err(|_| io::Error::new(io::ErrorKind::TimedOut, "embedded output did not close before drain deadline"))?,
+                None => read.await,
+            }.map_err(backend_error)?;
+            if let Some(failure) = page.failure {
+                return Err(CodexErr::Io(io::Error::other(failure)));
+            }
+            self.sandbox_denied |= page.sandbox_denied;
+            self.exit_code = page.exit_code.or(self.exit_code);
+            if page.exited && drain_deadline.is_none() {
+                drain_deadline = Some(tokio::time::Instant::now() + policy.io_drain_timeout());
+            }
+            // Closed describes the whole process, not the end of this retained page.
+            let drained = page.closed && page.chunks.is_empty();
+            for chunk in page.chunks {
+                let is_stderr = chunk.stream == BackendStream::Stderr;
+                let (target, emitted) = if is_stderr {
+                    (&mut self.stderr, &mut self.stderr_deltas)
+                } else {
+                    (&mut self.stdout, &mut self.stdout_deltas)
+                };
+                match policy.retained_bytes_cap() {
+                    Some(cap) => append_capped(target, &chunk.chunk.0, cap),
+                    None => target.extend_from_slice(&chunk.chunk.0),
+                }
+                if let Some(stream) = stream {
+                    for bytes in chunk.chunk.0.chunks(READ_CHUNK_SIZE) {
+                        if *emitted >= MAX_EXEC_OUTPUT_DELTAS_PER_CALL {
+                            break;
+                        }
+                        let send = stream.tx_event.send(Event {
+                            id: stream.sub_id.clone(),
+                            msg: EventMsg::ExecCommandOutputDelta(ExecCommandOutputDeltaEvent {
+                                call_id: stream.call_id.clone(),
+                                stream: if is_stderr { ExecOutputStream::Stderr } else { ExecOutputStream::Stdout },
+                                chunk: bytes.to_vec(),
+                            }),
+                        });
+                        if let Some(deadline) = drain_deadline {
+                            let _ = tokio::time::timeout_at(deadline, send).await.map_err(|_| {
+                                io::Error::new(io::ErrorKind::TimedOut, "embedded output consumer stalled")
+                            })?;
+                        } else {
+                            let _ = send.await;
+                        }
+                        *emitted += 1;
+                    }
+                }
+            }
+            after_seq = page.next_seq.checked_sub(1).or(after_seq);
+            if drained {
+                if !page.exited || self.exit_code.is_none() {
+                    return Err(CodexErr::Io(io::Error::other("embedded process closed without exit status")));
+                }
+                return Ok(());
+            }
+        }
+    }
+
+    fn output(self, policy: ExecCapturePolicy, outcome: Option<ExecExpirationOutcome>) -> RawExecToolCallOutput {
+        let timed_out = matches!(outcome, Some(ExecExpirationOutcome::TimedOut));
+        let interrupted = outcome.is_some();
+        let discard = interrupted && matches!(policy,
+            ExecCapturePolicy::FullBufferWithExpiration | ExecCapturePolicy::SensitiveFullBuffer);
+        let stdout = StreamOutput { text: if discard { Vec::new() } else { self.stdout }, truncated_after_lines: None };
+        let stderr = StreamOutput { text: if discard { Vec::new() } else { self.stderr }, truncated_after_lines: None };
+        let aggregated_output = aggregate_output(&stdout, &stderr, policy.retained_bytes_cap());
+        RawExecToolCallOutput {
+            // Native status is only a carrier; preserve the full executor i32 in finalization.
+            exit_status: synthetic_exit_status_for_code(0),
+            stdout, stderr, aggregated_output, timed_out,
+        }
+    }
+}
+
+/// Runs an already-authorized portable request through an embedded backend.
+///
+/// This is the direct one-shot counterpart to model-facing unified exec. It
+/// performs no approval/policy selection: the trusted caller supplies the actual
+/// `ExecParams` sandbox, environment and managed-network context. They are passed
+/// unchanged to the backend, which must enforce them or reject before starting.
+/// Do not pass a host-wrapped argv from `execute_env` or infer policy from env vars.
+///
+/// Interactive stdin/PTY, executor proxy launch and shell snapshots are rejected
+/// in this initial API. Use unified exec for interactive processes. Full-buffer
+/// capture policies retain their existing unbounded semantics; use ShellTool for
+/// model output. Timeout/cancel/error awaits termination; dropping this future
+/// schedules cleanup and requires the embedding runtime to remain alive.
+#[allow(clippy::too_many_arguments)]
+pub async fn execute_embedded_command(
+    environment: &Environment,
+    params: codex_exec_server::ExecParams,
+    expiration: ExecExpiration,
+    capture_policy: ExecCapturePolicy,
+    stdout_stream: Option<StdoutStream>,
+    after_spawn: Option<Box<dyn FnOnce() + Send>>,
+) -> Result<ExecToolCallOutput> {
+    if !environment.is_embedded() {
+        return Err(CodexErr::InvalidRequest("direct embedded execution requires an embedded environment".into()));
+    }
+    if params.tty || params.pipe_stdin || params.shell_snapshot.is_some() || params.network_proxy.is_some() {
+        return Err(CodexErr::InvalidRequest("unsupported embedded one-shot capability".into()));
+    }
+    if params.enforce_managed_network && params.managed_network.is_none() {
+        return Err(CodexErr::InvalidRequest("embedded managed networking requires an enforcement context".into()));
+    }
+    let start = Instant::now();
+    let expiration_wait = async {
+        if capture_policy.uses_expiration() {
+            expiration.wait_with_outcome().await
+        } else {
+            std::future::pending().await
+        }
+    };
+    tokio::pin!(expiration_wait);
+    let backend = environment.get_exec_backend();
+    // ExecBackend::start must be cancellation-safe before publishing its handle,
+    // as required by unified exec too. A detached start cannot satisfy this API.
+    let started = tokio::select! {
+        biased;
+        outcome = &mut expiration_wait => {
+            return finalize_exec_result_with_exit_code(Ok(Capture::default().output(capture_policy, Some(outcome))),
+                SandboxType::None, start.elapsed(), capture_policy, Some(1));
+        }
+        result = backend.start(params) => result.map_err(backend_error)?,
+    };
+    let sandbox_type = started.sandbox_type.unwrap_or(SandboxType::None);
+    let process = started.process;
+    let mut guard = TerminateOnDrop(Some(Arc::clone(&process)));
+    if let Some(after_spawn) = after_spawn {
+        after_spawn();
+    }
+    let mut capture = Capture::default();
+    let (result, outcome) = tokio::select! {
+        biased;
+        outcome = &mut expiration_wait => (Ok(()), Some(outcome)),
+        result = capture.collect(process.as_ref(), capture_policy, stdout_stream.as_ref()) => (result, None),
+    };
+    if result.is_err() || outcome.is_some() {
+        process.terminate().await.map_err(backend_error)?;
+    }
+    guard.0 = None;
+    result?;
+    let sandbox_denied = capture.sandbox_denied;
+    let exit_code = if outcome.is_some() { 1 } else { capture.exit_code.unwrap_or(1) };
+    let output = finalize_exec_result_with_exit_code(Ok(capture.output(capture_policy, outcome)),
+        sandbox_type, start.elapsed(), capture_policy, Some(exit_code))?;
+    if sandbox_denied {
+        return Err(CodexErr::Sandbox(SandboxErr::Denied {
+            output: Box::new(output), network_policy_decision: None,
+        }));
+    }
+    Ok(output)
+}
+
