+//! Deterministic contract fixtures, not an iSH adapter or device evidence.
+use super::*;
+use codex_exec_server::ExecBackend;
+use codex_exec_server::ExecBackendFuture;
+use codex_exec_server::ExecProcessEventLog;
+use codex_exec_server::ExecProcessEventReceiver;
+use codex_exec_server::ExecProcessFuture;
+use codex_exec_server::ProcessId;
+use codex_exec_server::ProcessOutputChunk;
+use codex_exec_server::ProcessSignal;
+use codex_exec_server::ReadResponse;
+use codex_exec_server::StartedExecProcess;
+use codex_exec_server::WriteResponse;
+use codex_exec_server::WriteStatus;
+use codex_http_client::HttpClientFactory;
+use codex_http_client::OutboundProxyPolicy;
+use std::collections::VecDeque;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use tokio::sync::{Notify, watch};
+
+struct TestProcess {
+    id: ProcessId,
+    pages: Mutex<VecDeque<ReadResponse>>,
+    events: ExecProcessEventLog,
+    wake: watch::Sender<u64>,
+    terminated: AtomicUsize,
+}
+impl ExecProcess for TestProcess {
+    fn process_id(&self) -> &ProcessId { &self.id }
+    fn subscribe_wake(&self) -> watch::Receiver<u64> { self.wake.subscribe() }
+    fn subscribe_events(&self) -> ExecProcessEventReceiver { self.events.subscribe() }
+    fn read(&self, _: Option<u64>, _: Option<usize>, _: Option<u64>) -> ExecProcessFuture<'_, ReadResponse> {
+        Box::pin(async move {
+            let page = self.pages.lock().unwrap().pop_front();
+            match page { Some(page) => Ok(page), None => std::future::pending().await }
+        })
+    }
+    fn write(&self, _: Vec<u8>) -> ExecProcessFuture<'_, WriteResponse> {
+        Box::pin(async { Ok(WriteResponse { status: WriteStatus::StdinClosed }) })
+    }
+    fn signal(&self, _: ProcessSignal) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async { Err(ExecServerError::Protocol("fixture has no interactive stdin".into())) })
+    }
+    fn terminate(&self) -> ExecProcessFuture<'_, ()> {
+        Box::pin(async { self.terminated.fetch_add(1, Ordering::SeqCst); Ok(()) })
+    }
+}
+struct TestBackend {
+    process: Arc<TestProcess>,
+    starts: AtomicUsize,
+}
+impl ExecBackend for TestBackend {
+    fn start(&self, params: codex_exec_server::ExecParams) -> ExecBackendFuture<'_> {
+        Box::pin(async move {
+            self.starts.fetch_add(1, Ordering::SeqCst);
+            assert_eq!(params.argv, ["test-command"]);
+            Ok(StartedExecProcess { process: self.process.clone(), sandbox_type: None })
+        })
+    }
+}
+fn page(chunks: Vec<ProcessOutputChunk>) -> ReadResponse {
+    ReadResponse { chunks, next_seq: 3, exited: true, exit_code: Some(7), closed: true,
+        failure: None, sandbox_denied: false }
+}
+fn setup(pages: Vec<ReadResponse>) -> (Environment, Arc<TestBackend>, codex_exec_server::ExecParams) {
+    let native = Environment::default_for_tests();
+    let mut info = codex_exec_server::EnvironmentInfo::local();
+    info.capabilities = Default::default();
+    let cwd = info.cwd.clone().unwrap();
+    let process = Arc::new(TestProcess {
+        id: "test-process".into(), pages: Mutex::new(pages.into()),
+        events: ExecProcessEventLog::bounded(4, 8192).unwrap(),
+        wake: watch::channel(0).0, terminated: AtomicUsize::new(0),
+    });
+    let backend = Arc::new(TestBackend { process, starts: AtomicUsize::new(0) });
+    let environment = Environment::embedded(backend.clone(), native.get_filesystem(), info,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault)).unwrap();
+    let params = codex_exec_server::ExecParams {
+        process_id: "test-process".into(), metadata: None, argv: vec!["test-command".into()],
+        cwd, env_policy: None, shell_snapshot: None, env: Default::default(), tty: false,
+        pipe_stdin: false, arg0: None, sandbox: None, enforce_managed_network: false,
+        managed_network: None, network_proxy: None,
+    };
+    (environment, backend, params)
+}
+
+#[tokio::test]
+async fn drains_closed_pages_and_preserves_streams_and_exit_status() {
+    let chunks = vec![
+        ProcessOutputChunk { seq: 1, stream: BackendStream::Stdout, chunk: "中文".as_bytes().to_vec().into() },
+        ProcessOutputChunk { seq: 2, stream: BackendStream::Stderr, chunk: b"error".to_vec().into() },
+    ];
+    let (env, backend, params) = setup(vec![page(chunks), page(Vec::new())]);
+    let result = execute_embedded_command(&env, params, 1000.into(), ExecCapturePolicy::ShellTool, None, None).await.unwrap();
+    assert_eq!(result.stdout.text, "中文");
+    assert_eq!(result.stderr.text, "error");
+    assert_eq!(result.exit_code, 7);
+    assert!(!result.timed_out);
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn timeout_confirms_termination_and_reports_timeout() {
+    let (env, backend, params) = setup(vec![]);
+    let result = execute_embedded_command(&env, params, 5.into(), ExecCapturePolicy::ShellTool, None, None).await;
+    assert!(matches!(result, Err(CodexErr::Sandbox(SandboxErr::Timeout { .. }))));
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn cancellation_after_spawn_is_not_reported_as_timeout() {
+    let (env, backend, params) = setup(vec![]);
+    let cancellation = CancellationToken::new();
+    let cancel = cancellation.clone();
+    let output = execute_embedded_command(&env, params, ExecExpiration::Cancellation(cancellation),
+        ExecCapturePolicy::ShellTool, None, Some(Box::new(move || cancel.cancel()))).await.unwrap();
+    assert_eq!(output.exit_code, 1);
+    assert!(!output.timed_out);
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn dropping_capture_schedules_process_cleanup() {
+    let (env, backend, params) = setup(vec![]);
+    let started = Arc::new(Notify::new());
+    let callback = started.clone();
+    let task = tokio::spawn(async move {
+        execute_embedded_command(&env, params, 10000.into(), ExecCapturePolicy::ShellTool,
+            None, Some(Box::new(move || callback.notify_one()))).await
+    });
+    started.notified().await;
+    task.abort();
+    let _ = task.await;
+    tokio::time::timeout(Duration::from_secs(1), async {
+        while backend.process.terminated.load(Ordering::SeqCst) == 0 { tokio::task::yield_now().await; }
+    }).await.unwrap();
+}
+
+#[tokio::test]
+async fn incomplete_managed_network_context_is_rejected_before_start() {
+    let (env, backend, mut params) = setup(vec![]);
+    params.enforce_managed_network = true;
+    assert!(execute_embedded_command(&env, params, 1000.into(), ExecCapturePolicy::ShellTool, None, None).await.is_err());
+    assert_eq!(backend.starts.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn output_cap_and_executor_sandbox_denial_are_preserved() {
+    let mut first = page(vec![ProcessOutputChunk { seq: 1, stream: BackendStream::Stdout,
+        chunk: vec![b'x'; EXEC_OUTPUT_MAX_BYTES + 10].into() }]);
+    first.sandbox_denied = true;
+    let (env, backend, params) = setup(vec![first, page(Vec::new())]);
+    let result = execute_embedded_command(&env, params, 1000.into(), ExecCapturePolicy::ShellTool, None, None).await;
+    match result {
+        Err(CodexErr::Sandbox(SandboxErr::Denied { output, .. })) => assert_eq!(output.stdout.text.len(), EXEC_OUTPUT_MAX_BYTES),
+        other => panic!("expected executor denial, got {other:?}"),
+    }
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 0);
+}
+
+#[tokio::test]
+async fn full_buffer_deadline_stays_active_after_exit_with_open_output() {
+    let mut first = page(vec![ProcessOutputChunk { seq: 1, stream: BackendStream::Stdout,
+        chunk: b"partial".to_vec().into() }]);
+    first.closed = false;
+    let (env, backend, params) = setup(vec![first]);
+    let result = execute_embedded_command(&env, params, 5.into(), ExecCapturePolicy::FullBufferWithExpiration, None, None).await;
+    match result {
+        Err(CodexErr::Sandbox(SandboxErr::Timeout { output })) => assert!(output.stdout.text.is_empty()),
+        other => panic!("expected timeout while draining, got {other:?}"),
+    }
+    assert_eq!(backend.process.terminated.load(Ordering::SeqCst), 1);
+}
+
+#[tokio::test]
+async fn stalled_stream_consumer_is_bounded_even_for_full_buffer() {
+    let (env, backend, params) = setup(vec![page(vec![ProcessOutputChunk {
+        seq: 1, stream: BackendStream::Stdout, chunk: vec![b'x'; READ_CHUNK_SIZE * 2].into(),
+    }])]);
