+#[tokio::test]
+async fn embedded_launch_without_snapshot_uses_backend_and_preserves_network_context() {
+    use codex_exec_server::Environment;
+    use codex_exec_server::ExecBackend;
+    use codex_exec_server::ExecBackendFuture;
+    use codex_exec_server::ExecServerError;
+    use codex_http_client::HttpClientFactory;
+    use codex_http_client::OutboundProxyPolicy;
+    use codex_protocol::config_types::WindowsSandboxLevel;
+    use codex_protocol::models::PermissionProfile;
+    use codex_sandboxing::SandboxType;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+    use std::sync::atomic::AtomicBool;
+    use std::sync::atomic::Ordering;
+
+    struct RejectingBackend(Arc<AtomicBool>);
+    impl ExecBackend for RejectingBackend {
+        fn start(&self, params: codex_exec_server::ExecParams) -> ExecBackendFuture<'_> {
+            Box::pin(async move {
+                self.0.store(true, Ordering::SeqCst);
+                assert_eq!(params.argv, ["must-not-spawn-on-host"]);
+                assert!(params.shell_snapshot.is_none());
+                assert!(params.enforce_managed_network);
+                assert_eq!(params.managed_network.unwrap().loopback_ports, [43123]);
+                assert_eq!(params.env.get("TEST_VALUE").map(String::as_str), Some("guest"));
+                Err(ExecServerError::Protocol("embedded test refusal".into()))
+            })
+        }
+    }
+    let called = Arc::new(AtomicBool::new(false));
+    let native = Environment::default_for_tests();
+    let mut info = codex_exec_server::EnvironmentInfo::local();
+    info.capabilities = Default::default();
+    let environment = Environment::embedded(
+        Arc::new(RejectingBackend(called.clone())), native.get_filesystem(), info,
+        HttpClientFactory::new(OutboundProxyPolicy::ReqwestDefault),
+    ).unwrap();
+    let cwd = AbsolutePathBuf::try_from(std::env::current_dir().unwrap()).unwrap();
+    let mut request = ExecRequest::new(
+        vec!["must-not-spawn-on-host".into()], cwd, HashMap::from([("TEST_VALUE".into(), "guest".into())]),
+        None, None, crate::exec::ExecExpiration::DefaultTimeout, crate::exec::ExecCapturePolicy::ShellTool,
+        SandboxType::None, Vec::new(), WindowsSandboxLevel::Disabled, PermissionProfile::Disabled, None,
+    );
+    request.exec_server_enforce_managed_network = true;
+    request.exec_server_managed_network = Some(ManagedNetworkSandboxContext {
+        loopback_ports: vec![43123], ..Default::default()
+    });
+    let result = UnifiedExecProcessManager::default().open_session_with_prepared_exec_env(
+        123, &request, None, codex_sandboxing::WindowsSandboxProxySettingsMode::Preserve,
+        None, false, &environment,
+    ).await;
+    let error = match result { Err(error) => error, Ok(_) => panic!("backend must refuse") };
+    assert!(error.to_string().contains("embedded test refusal"));
+    assert!(called.load(Ordering::SeqCst));
+}
