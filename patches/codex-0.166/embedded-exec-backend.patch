+#[tokio::test]
+async fn executor_exit_codes_are_not_narrowed_to_native_wait_status() {
+    for code in [-1, 256, 65536] {
+        let mut finished = page(Vec::new());
+        finished.exit_code = Some(code);
+        let (env, _, params) = setup(vec![finished]);
+        let result = execute_embedded_command(&env, params, 1000.into(), ExecCapturePolicy::ShellTool, None, None).await.unwrap();
+        assert_eq!(result.exit_code, code);
+    }
+}
