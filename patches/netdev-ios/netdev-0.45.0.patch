+#[cfg(target_os = "macos")]
+pub use crate::os::darwin::ipv6_addr_flags::query_ipv6_addr_flags;
+
+/// Query flags without interpreting unavailable metadata as a successful read.
+///
+/// iOS has no public SDK `SIOCGIFAFLAG_IN6` interface. Always returns
+/// [`std::io::ErrorKind::Unsupported`]; no socket, ioctl, or private ABI is used.
+#[cfg(target_os = "ios")]
+pub fn query_ipv6_addr_flags(
+    _ifname: &str,
+    _addr: &std::net::Ipv6Addr,
+) -> std::io::Result<Ipv6AddrFlags> {
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "IPv6 address flag queries are unavailable in the iOS public SDK",
+    ))
+}
+
+// Preserve the legacy bool-only metadata and netwatch's parallel-vector contract.
+// Defaults are unknown metadata; an error must never remove an enumerated address.
+#[cfg(any(target_os = "macos", target_os = "ios"))]
+pub(crate) fn get_ipv6_addr_flags(ifname: &str, addr: &std::net::Ipv6Addr) -> Ipv6AddrFlags {
+    query_ipv6_addr_flags(ifname, addr).unwrap_or_default()
+}
 
