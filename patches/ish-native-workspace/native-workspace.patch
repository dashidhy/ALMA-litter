+    if(fd<0)return _ENOTSUP;
+    unsigned entries=0;int result=audit_tree(fd,0,&entries);close(fd);
+    if(result)return result;
+    result=generic_mkdirat(AT_PWD,"/workspace",0700);
+    if(result && result!=_EEXIST)return result;
+    lock(&mounts_lock);
+    struct mount *mount;
+    list_for_each_entry(&mounts,mount,mounts) {
+        if(!strcmp(mount->point,"/workspace")){unlock(&mounts_lock);return _EBUSY;}
+    }
+    result=do_mount(&realfs,source,"/workspace","",0);
+    if(!result)list_for_each_entry(&mounts,mount,mounts) {
+        if(!strcmp(mount->point,"/workspace")){mount->workspace_native_authorized=true;break;}
+    }
+    unlock(&mounts_lock);return result;
