+// The source is a trusted private controller-owned directory, never a tool arg.
+int ish_workspace_mount_native(const char *source) {
+    if(!source || !ish_job_controller_current() || ish_workspace_enabled())return _EPERM;
+    lock(&pids_lock);
+    bool children=!list_empty(&current->children);unlock(&pids_lock);
+    if(children)return _EBUSY;
