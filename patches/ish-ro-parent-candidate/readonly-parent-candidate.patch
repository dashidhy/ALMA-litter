+// The only permitted same-grant overlap is a strictly read-only ancestor
+// plus an explicitly writable descendant. OR-based runtime rights then remain
+// correct: the ancestor never contributes write authority. This is not a
+// general longest-prefix policy and must not admit writable ancestors.
+static bool readonly_parent_candidate(const struct wp_root *parent, const struct wp_root *candidate) {
+    return parent->rights==WP_READ && candidate->rights==(WP_READ|WP_WRITE) &&
+        strcmp(parent->path,candidate->path) && under(candidate->path,parent->path);
+}
+static bool verified_readonly_parent_candidate(const struct wp_root *parent, const struct wp_root *candidate) {
+    if (!readonly_parent_candidate(parent,candidate) || !parent->depth || parent->depth>=candidate->depth)
+        return false;
+    // Both walks used the selected authorized mount and O_NOFOLLOW. Require
+    // the entire retained device/inode ancestry prefix, not just path strings
+    // or one coincident inode. This also rejects identical physical roots.
+    for (unsigned i=0;i<parent->depth;i++)
+        if (!same_identity(parent->ancestry[i],candidate->ancestry[i])) return false;
+    return true;
+}
 static void free_grant(struct ish_workspace_grant *g) {
     for (unsigned i=0;i<WP_GRANTS;i++) if (grants[i]==g) { grants[i]=NULL; free(g); return; }
 }
