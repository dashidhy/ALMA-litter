+fn flush_owned_stdin(sessions: &mut HashMap<u32, Session>, id: u32) -> io::Result<()> {
+    let Some(s) = sessions.get_mut(&id) else { return Ok(()); };
+    if s.cancel_requested || s.exited_announced { s.pending_stdin.clear(); return Ok(()); }
+    if s.job.is_none() || s.pending_stdin.is_empty() { return Ok(()); }
+    let Some(fd) = s.stdin_target() else { s.pending_stdin.clear(); return Ok(()); };
+    let bytes = s.pending_stdin.make_contiguous();
+    let n = unsafe { libc::write(fd, bytes.as_ptr().cast(), bytes.len().min(32 * 1024)) };
+    if n > 0 { s.pending_stdin.drain(..n as usize); }
+    else if n < 0 {
+        let error = io::Error::last_os_error();
+        if !matches!(error.kind(), io::ErrorKind::WouldBlock | io::ErrorKind::Interrupted) {
+            s.pending_stdin.clear();
+            write_frame(&SupervisorToHost::Err { reqid: Some(id), code: error.raw_os_error().unwrap_or(libc::EIO) as u32,
+                msg: format!("owned stdin: {error}") })?;
+        }
+    }
+    Ok(())
 }
 
