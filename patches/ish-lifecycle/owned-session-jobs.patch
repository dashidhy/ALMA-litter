+//! Private kernel job ABI. Authority belongs only to the host-enabled init task.
+use std::io;
+const PRCTL: libc::c_int = 0x49534a42;
+fn call(op: u32, id: u32) -> io::Result<u32> {
+    let rc = unsafe { libc::prctl(PRCTL, op as libc::c_ulong, id as libc::c_ulong, 0usize, 0usize) };
+    if rc < 0 { Err(io::Error::last_os_error()) } else { Ok(rc as u32) }
+}
+pub fn enabled() -> io::Result<bool> {
+    match call(0, 0) {
+        Ok(1) => Ok(true),
+        Err(e) if matches!(e.raw_os_error(), Some(libc::ENOSYS | libc::EINVAL)) => Ok(false),
+        Err(e) => Err(e),
+        _ => Err(io::Error::other("unexpected job ABI capability")),
+    }
+}
+pub fn begin() -> io::Result<Option<u32>> {
+    if enabled()? { call(1, 0).map(Some) } else { Ok(None) }
+}
+pub fn disarm(id: u32) -> io::Result<()> { call(2, id).map(|_| ()) }
+pub fn cancel(id: u32) -> io::Result<()> { call(3, id).map(|_| ()) }
+pub fn live(id: u32) -> io::Result<u32> { call(4, id) }
+pub fn release(id: u32) -> io::Result<()> { call(5, id).map(|_| ()) }
+
+pub fn interrupt(id: u32) -> io::Result<()> { call(6, id).map(|_| ()) }
