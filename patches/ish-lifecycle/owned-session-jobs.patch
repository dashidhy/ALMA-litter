new file mode 100644
--- /dev/null
+++ b/kernel/session_job.c
@@ -0,0 +1,121 @@
+#include <stdint.h>
+#include "kernel/calls.h"
+#include "kernel/session_job.h"
+
+#define JOB_LIMIT 64
+struct session_job { dword_t id, live; bool cancelled; };
+static struct session_job jobs[JOB_LIMIT];
+static struct task *controller;
+static dword_t armed_job, last_job;
+
+static struct session_job *find_job(dword_t id) {
+    if (!id) return NULL;
+    for (unsigned i = 0; i < JOB_LIMIT; i++)
+        if (jobs[i].id == id) return &jobs[i];
+    return NULL;
+}
+
+static void signal_job_locked(dword_t id, int sig) {
+    for (dword_t pid = 1; pid <= MAX_PID; pid++) {
+        struct task *task = pid_get_task_zombie(pid);
+        if (task && task->session_job == id && task->session_job_started && !task->exiting)
+            send_signal(task, sig, SIGINFO_NIL);
+    }
+}
+
+int ish_job_enable_controller(void) {
+    lock(&pids_lock);
+    // Host boot only, before any guest task is started. Authority is task
+    // identity, not uid, a process name, an environment variable or a guest pid.
+    int result = 0;
+    if (!current || current->pid != 1 || controller || !list_empty(&current->children))
+        result = _EPERM;
+    else controller = current;
+    unlock(&pids_lock);
+    return result;
+}
+
+int_t ish_job_control(dword_t op, dword_t id) {
+    lock(&pids_lock);
+    int_t result = _EINVAL;
+    if (!controller) { result = _ENOSYS; goto out; }
+    if (current != controller) { result = _EPERM; goto out; }
+    if (op == ISH_JOB_CAP) { result = 1; goto out; }
+    if (op == ISH_JOB_NEW) {
+        if (armed_job) { result = _EBUSY; goto out; }
+        // IDs are never reused, including after RELEASE. Avoid pid/slot ABA.
+        if (last_job == INT32_MAX) { result = _ENOSPC; goto out; }
+        result = _ENOSPC;
+        for (unsigned i = 0; i < JOB_LIMIT; i++) if (!jobs[i].id) {
+            jobs[i] = (struct session_job) {.id = ++last_job};
+            armed_job = jobs[i].id;
+            result = armed_job;
+            break;
+        }
+        goto out;
+    }
+    struct session_job *job = find_job(id);
+    if (!job) { result = _ESRCH; goto out; }
+    switch (op) {
+    case ISH_JOB_DISARM:
+        if (armed_job == id) armed_job = 0;
+        result = 0;
+        break;
+    case ISH_JOB_CANCEL:
+        job->cancelled = true; // sticky; prevents any later successful fork
+        if (armed_job == id) armed_job = 0;
+        signal_job_locked(id, SIGKILL_);
+        result = 0; // request accepted, NOT completion
+        break;
+    case ISH_JOB_INTERRUPT:
+        signal_job_locked(id, SIGINT_);
+        result = 0;
+        break;
+    case ISH_JOB_LIVE:
+        result = job->live;
+        break;
+    case ISH_JOB_RELEASE:
+        if (job->live || armed_job == id) result = _EBUSY;
+        else { *job = (struct session_job) {}; result = 0; }
+        break;
+    }
+out:
+    unlock(&pids_lock);
+    return result;
+}
+
+bool ish_job_inherit_locked(struct task *task, struct task *parent) {
+    dword_t id = parent ? parent->session_job : 0;
+    if (parent == controller) { id = armed_job; armed_job = 0; }
+    task->session_job = id;
+    task->session_job_started = false;
+    if (!id) return true;
+    struct session_job *job = find_job(id);
+    if (!job || job->cancelled) return false;
+    job->live++; // includes a fork reservation until failure or pthread cleanup
+    return true;
+}
+
+bool ish_job_cancelled_locked(dword_t id) {
+    struct session_job *job = find_job(id);
+    return job && job->cancelled;
+}
+
+void ish_job_unstarted_destroy_locked(struct task *task) {
+    if (!task->session_job_started && task->session_job) {
+        struct session_job *job = find_job(task->session_job);
+        if (job && job->live) job->live--;
+        task->session_job = 0;
+    }
+}
+
+void ish_job_thread_cleanup(void *opaque) {
+    dword_t id = (dword_t)(uintptr_t)opaque;
+    if (!id) return;
+    // Called after task_run_current's TLB cleanup, even on pthread_exit.
+    // Do not read the task: it may have been reaped already.
+    lock(&pids_lock);
+    struct session_job *job = find_job(id);
+    if (job && job->live) job->live--;
+    unlock(&pids_lock);
+}
