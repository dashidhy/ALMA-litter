+fn kill_all(sessions: &mut HashMap<u32, Session>, sig: libc::c_int) -> io::Result<()> {
+    for s in sessions.values_mut() {
+        if let Some(job) = s.job {
+            s.cancel_requested = true;
+            s.pending_stdin.clear();
+            s.stdin_w.take();
