diff --git a/kernel/workspace_fd.c b/kernel/workspace_fd.c
new file mode 100644
--- /dev/null
+++ b/kernel/workspace_fd.c
@@ -0,0 +1,34 @@
+#include <stdlib.h>
+#include "kernel/calls.h"
+#include "kernel/workspace_policy.h"
+#define CHECK(fd, right) do { int e=ish_workspace_fd(fd,right); if(e)return e; } while(0)
+static ssize_t wp_read(struct fd *f,void *b,size_t n) { CHECK(f,WP_READ); return f->workspace_original_ops->read(f,b,n); }
+static ssize_t wp_write(struct fd *f,const void *b,size_t n) { CHECK(f,WP_WRITE); return f->workspace_original_ops->write(f,b,n); }
+static ssize_t wp_pread(struct fd *f,void *b,size_t n,off_t o) { CHECK(f,WP_READ); return f->workspace_original_ops->pread(f,b,n,o); }
+static ssize_t wp_pwrite(struct fd *f,const void *b,size_t n,off_t o) { CHECK(f,WP_WRITE); return f->workspace_original_ops->pwrite(f,b,n,o); }
+static int wp_readdir(struct fd *f,struct dir_entry *e) { CHECK(f,WP_READ); return f->workspace_original_ops->readdir(f,e); }
+static int wp_mmap(struct fd *f,struct mem *m,page_t s,pages_t n,off_t o,int p,int flags) {
+    CHECK(f,WP_READ);
+    // Reject file-backed shared maps, including read-only maps later made writable.
+    if(ish_workspace_current() && (flags&MMAP_SHARED) && !is_adhoc_fd(f))return _ENOTSUP;
+    return f->workspace_original_ops->mmap(f,m,s,n,o,p,flags);
+}
+static int wp_ioctl(struct fd *f,int cmd,void *arg) {
+    CHECK(f,WP_READ);
+    if(ish_workspace_current() && cmd!=FIONREAD_)return _ENOTSUP;
+    return f->workspace_original_ops->ioctl(f,cmd,arg);
+}
+int ish_workspace_wrap(struct fd *f) {
+    if(!ish_workspace_enabled() || f->workspace_ops)return 0;
+    struct fd_ops *ops=malloc(sizeof(*ops));if(!ops)return _ENOMEM;
+    const struct fd_ops *original=f->ops;*ops=*original;
+    if(ops->read)ops->read=wp_read;
+    if(ops->write)ops->write=wp_write;
+    if(ops->pread)ops->pread=wp_pread;
+    if(ops->pwrite)ops->pwrite=wp_pwrite;
+    if(ops->readdir)ops->readdir=wp_readdir;
+    if(ops->mmap)ops->mmap=wp_mmap;
+    if(ops->ioctl)ops->ioctl=wp_ioctl;
+    // Close stays unchanged, including identity comparison with fs->close.
+    f->workspace_original_ops=original;f->workspace_ops=ops;f->ops=ops;return 0;
+}
diff --git a/kernel/workspace_policy.c b/kernel/workspace_policy.c
new file mode 100644
--- /dev/null
+++ b/kernel/workspace_policy.c
@@ -0,0 +1,251 @@
+#include <stdatomic.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <string.h>
+#include <stdlib.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include "kernel/calls.h"
+#include "kernel/workspace_policy.h"
+#include "kernel/session_job.h"
+#include "fs/real.h"
+#include "fs/fake-db.h"
+#include "fs/sock.h"
+
+#define WP_GRANTS 64
+struct wp_identity { dev_t dev; ino_t ino; };
+struct wp_root {
+    char path[MAX_PATH]; unsigned rights, depth;
+    struct wp_identity ancestry[64];
+};
+struct ish_workspace_grant {
+    unsigned token, count;
+    bool bound, retired, release_requested;
+    struct wp_root roots[WP_ROOTS];
+};
+static struct ish_workspace_grant *grants[WP_GRANTS];
+static unsigned last_token;
+static atomic_bool enabled;
+extern struct mount *g_fakefs_mount;
+extern bool fakefs_has_bind_mounts(void);
+
+bool ish_workspace_enabled(void) { return atomic_load_explicit(&enabled, memory_order_acquire); }
+bool ish_workspace_frozen(void) {
+    return ish_workspace_enabled() && !(ish_job_controller_current() && current->exiting);
+}
+struct ish_workspace_grant *ish_workspace_current(void) {
+    return current ? current->workspace_grant : NULL;
+}
+static bool under(const char *path, const char *root) {
+    size_t n = strlen(root);
+    return !strncmp(path, root, n) && (path[n] == '/' || !path[n]);
+}
+static bool reserved(const char *p) {
+    return under(p,"/proc") || under(p,"/dev") || under(p,"/sys");
+}
+static bool canonical_root(const char *p) {
+    if (!p || p[0]!='/' || !p[1] || strlen(p)>=MAX_PATH || p[strlen(p)-1]=='/' || reserved(p)) return false;
+    for (const char *c=p; *c;) {
+        if (*c++!='/') return false;
+        size_t n=strcspn(c,"/");
+        if (!n || (n==1 && c[0]=='.') || (n==2 && c[0]=='.' && c[1]=='.')) return false;
+        c+=n;
+    }
+    return true;
+}
+// Audit only the private backing tree, descriptor-relative and never following
+// host symlinks. Guest symbolic links are fakefs metadata + ordinary data files.
+static int audit_tree(int dirfd, unsigned depth, unsigned *entries) {
+    if (depth>64) return _ENOTSUP;
+    DIR *dir=fdopendir(dup(dirfd)); if (!dir) return _EIO;
+    int result=0; struct dirent *entry;
+    while ((entry=readdir(dir))) {
+        if (!strcmp(entry->d_name,".") || !strcmp(entry->d_name,"..")) continue;
+        if (++*entries>100000) { result=_ENOTSUP; break; }
+        struct stat st;
+        if (fstatat(dirfd,entry->d_name,&st,AT_SYMLINK_NOFOLLOW)<0) { result=_EIO; break; }
+        if (S_ISDIR(st.st_mode)) {
+            int child=openat(dirfd,entry->d_name,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+            if (child<0) { result=_ENOTSUP; break; }
+            result=audit_tree(child,depth+1,entries); close(child);
+            if (result) break;
+        } else if (!S_ISREG(st.st_mode) || st.st_nlink!=1) { result=_ENOTSUP; break; }
+    }
+    closedir(dir); return result;
+}
+int ish_workspace_enable(void) {
+    if (!ish_job_controller_current() || ish_workspace_enabled()) return _EPERM;
+    lock(&pids_lock);
+    if (!list_empty(&current->children)) { unlock(&pids_lock); return _EBUSY; }
+    lock(&mounts_lock);
+    int result=0; struct mount *mount;
+    list_for_each_entry(&mounts,mount,mounts) {
+        if (mount!=g_fakefs_mount && mount->fs!=&procfs && mount->fs!=&devptsfs) result=_ENOTSUP;
+    }
+    if (!g_fakefs_mount || fakefs_has_bind_mounts()) result=_ENOTSUP;
+    if (!result) {
+        unsigned entries=0;
+        result=audit_tree(g_fakefs_mount->root_fd,0,&entries);
+        if (!result) {
+            struct fakefs_db *db=&g_fakefs_mount->fakefs;
+            db_begin_read(db);
+            sqlite3_stmt *stmt=NULL;
+            int rc=sqlite3_prepare_v2(db->db,"SELECT 1 FROM paths GROUP BY inode HAVING count(*)>1 LIMIT 1",-1,&stmt,NULL);
+            if (rc!=SQLITE_OK || sqlite3_step(stmt)!=SQLITE_DONE) result=_ENOTSUP;
+            sqlite3_finalize(stmt); db_commit(db);
+        }
+    }
+    if (!result) atomic_store_explicit(&enabled,true,memory_order_release);
+    unlock(&mounts_lock); unlock(&pids_lock); return result;
+}
+static int verify_root(struct wp_root *root) {
+    // Require exact fakefs metadata and walk actual directories without links.
+    struct statbuf fake;
+    if (fakefs.stat(g_fakefs_mount,root->path,&fake)<0 || !S_ISDIR(fake.mode))return _ENOTSUP;
+    int fd=dup(g_fakefs_mount->root_fd); if(fd<0)return _EIO;
+    struct stat st;
+    if(fstat(fd,&st)<0){close(fd);return _EIO;}
+    root->ancestry[root->depth++]=(struct wp_identity){st.st_dev,st.st_ino};
+    char copy[MAX_PATH];strcpy(copy,root->path+1);char *save=NULL;
+    for(char *c=strtok_r(copy,"/",&save);c;c=strtok_r(NULL,"/",&save)) {
+        int next=openat(fd,c,O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);close(fd);fd=next;
+        if(fd<0)return _ENOTSUP;
+        if(root->depth==64 || fstat(fd,&st)<0){close(fd);return _ENOTSUP;}
+        root->ancestry[root->depth++]=(struct wp_identity){st.st_dev,st.st_ino};
+    }
+    close(fd);return 0;
+}
+static bool same_identity(struct wp_identity a,struct wp_identity b) {return a.dev==b.dev && a.ino==b.ino;}
+static bool roots_overlap(const struct wp_root *a,const struct wp_root *b) {
+    for(unsigned i=0;i<b->depth;i++)if(same_identity(a->ancestry[a->depth-1],b->ancestry[i]))return true;
+    for(unsigned i=0;i<a->depth;i++)if(same_identity(b->ancestry[b->depth-1],a->ancestry[i]))return true;
+    return false;
+}
+static void free_grant(struct ish_workspace_grant *g) {
+    for (unsigned i=0;i<WP_GRANTS;i++) if (grants[i]==g) { grants[i]=NULL; free(g); return; }
+}
+int ish_workspace_register(const char *const *ro,size_t nro,const char *const *rw,size_t nrw,unsigned network) {
+    if (!ish_workspace_enabled()) return _EPERM;
+    if (network!=0 || !nro || nro>WP_ROOTS || nrw>WP_ROOTS-nro) return _ENOTSUP;
+    if (!ro || (nrw && !rw)) return _EINVAL;
+    struct ish_workspace_grant *g=calloc(1,sizeof(*g)); if (!g) return _ENOMEM;
+    g->count=nro+nrw;
+    for (unsigned i=0;i<g->count;i++) {
+        const char *p=i<nro?ro[i]:rw[i-nro];
+        if (!canonical_root(p)) { free(g); return _EINVAL; }
+        strcpy(g->roots[i].path,p); g->roots[i].rights=i<nro?WP_READ:WP_READ|WP_WRITE;
+        for (unsigned j=0;j<i;j++) if (under(p,g->roots[j].path)||under(g->roots[j].path,p)) { free(g);return _ENOTSUP; }
+    }
+    lock(&pids_lock); int slot=-1,result=0;
+    for(unsigned i=0;i<g->count && !result;i++)result=verify_root(&g->roots[i]);
+    for(unsigned i=0;i<g->count && !result;i++)for(unsigned j=0;j<i;j++)
+        if(roots_overlap(&g->roots[i],&g->roots[j]))result=_ENOTSUP;
+    if(result){free(g);unlock(&pids_lock);return result;}
+    for (unsigned k=0;k<WP_GRANTS;k++) {
+        if (!grants[k]) { slot=k; continue; }
+        struct ish_workspace_grant *other=grants[k];
+        for (unsigned i=0;i<g->count;i++) for (unsigned j=0;j<other->count;j++) {
+            if (((g->roots[i].rights|other->roots[j].rights)&WP_WRITE) &&
+                (roots_overlap(&g->roots[i],&other->roots[j]) ||
+                 under(g->roots[i].path,other->roots[j].path)||under(other->roots[j].path,g->roots[i].path))) result=_EBUSY;
+        }
+    }
+    if (slot<0 || last_token==INT32_MAX) result=_ENOSPC;
+    if (!result) { g->token=++last_token; grants[slot]=g; result=g->token; }
+    else free(g);
+    unlock(&pids_lock); return result;
+}
+struct ish_workspace_grant *ish_workspace_claim_locked(unsigned token) {
+    for (unsigned i=0;i<WP_GRANTS;i++) if (grants[i] && grants[i]->token==token) {
+        struct ish_workspace_grant *g=grants[i];
+        if (g->bound||g->retired||g->release_requested) return NULL;
+        g->bound=true; return g;
+    }
+    return NULL;
+}
+void ish_workspace_job_done_locked(struct ish_workspace_grant *g) {
+    if (!g) return;
+    g->bound=false;g->retired=true;
+    if (g->release_requested) free_grant(g);
+}
+int ish_workspace_release(unsigned token) {
+    lock(&pids_lock); int result=_ESRCH;
+    for (unsigned i=0;i<WP_GRANTS;i++) if (grants[i] && grants[i]->token==token) {
+        struct ish_workspace_grant *g=grants[i];g->release_requested=true;
+        if (g->bound) result=_EBUSY;
+        else { free_grant(g);result=0; }
+        break;
+    }
+    unlock(&pids_lock); return result;
+}
+static bool safe_device(const char *p) {
+    return !strcmp(p,"/dev/null")||!strcmp(p,"/dev/zero")||!strcmp(p,"/dev/full")||!strcmp(p,"/dev/random")||!strcmp(p,"/dev/urandom");
+}
+static bool safe_proc(const char *p) {
+    if (!strcmp(p,"/proc/meminfo")||!strcmp(p,"/proc/cpuinfo")||!strcmp(p,"/proc/version")) return true;
+    char own[40]; snprintf(own,sizeof(own),"/proc/%u",current->tgid);
+    const char *rest=NULL;
+    if (under(p,"/proc/self")) rest=p+10;
+    else if (under(p,own)) rest=p+strlen(own);
+    return rest && (!strcmp(rest,"/exe")||!strcmp(rest,"/maps")||!strcmp(rest,"/stat")||!strcmp(rest,"/status"));
+}
+static int rights(struct ish_workspace_grant *g,const char *p) {
+    if (safe_device(p)) return WP_READ|WP_WRITE;
+    if (safe_proc(p)) return WP_READ;
+    if (reserved(p)) return 0;
+    int r=0;
+    for (unsigned i=0;i<g->count;i++) {
+        if (under(p,g->roots[i].path)) r|=g->roots[i].rights;
+        if (!strcmp(p,"/")||!p[0]||under(g->roots[i].path,p)) r|=WP_TRAVERSE;
+    }
+    return r;
+}
+int ish_workspace_path(const char *path,int access) {
+    struct ish_workspace_grant *g=ish_workspace_current(); if (!g)return 0;
+    if (access==WP_TRAVERSE && (!strcmp(path,"/proc")||!strcmp(path,"/proc/self")||!strcmp(path,"/dev")))return 0;
+    char own[40];snprintf(own,sizeof(own),"/proc/%u",current->tgid);
+    if (access==WP_TRAVERSE && !strcmp(path,own))return 0;
+    int r=rights(g,path);
+    return (access==WP_TRAVERSE ? (r&(WP_READ|WP_TRAVERSE)) : ((r&access)==access)) ? 0 : _EACCES;
+}
+int ish_workspace_mutation(const char *p) {
+    struct ish_workspace_grant *g=ish_workspace_current();if(!g)return 0;
+    if (reserved(p))return _EPERM;
+    for(unsigned i=0;i<g->count;i++) if(!strcmp(p,g->roots[i].path))return _EPERM;
+    return ish_workspace_path(p,WP_WRITE);
+}
+int ish_workspace_rename(const char *src,const char *dst) {
+    struct ish_workspace_grant *g=ish_workspace_current();if(!g)return 0;
+    int e=ish_workspace_mutation(src);if(e)return e;e=ish_workspace_mutation(dst);if(e)return e;
+    bool same=false;for(unsigned i=0;i<g->count;i++) if((g->roots[i].rights&WP_WRITE)&&under(src,g->roots[i].path)&&under(dst,g->roots[i].path))same=true;
+    if(!same)return _EXDEV;
+    struct statbuf st;
+    if (fakefs.stat(g_fakefs_mount,src,&st)<0 || !S_ISREG(st.mode))return _ENOTSUP;
+    if (fakefs.stat(g_fakefs_mount,dst,&st)>=0 && !S_ISREG(st.mode))return _ENOTSUP;
+    return 0;
+}
+int ish_workspace_before_open(const char *p,int flags) {
+    if(!ish_workspace_current())return 0;
+    bool write=flags&(O_WRONLY_|O_RDWR_|O_CREAT_|O_TRUNC_|O_APPEND_);
+    int e=ish_workspace_path(p,write?WP_WRITE:WP_READ);if(e)return e;
+    struct statbuf st;
+    if(fakefs.stat(g_fakefs_mount,p,&st)>=0 && !S_ISREG(st.mode)&&!S_ISDIR(st.mode)&&!safe_device(p))return _ENOTSUP;
+    return 0;
+}
+int ish_workspace_tag_open(struct fd *fd,const char *p) {
+    struct ish_workspace_grant *g=ish_workspace_current();if(!g)return 0;
+    if(fd->mount->fs!=&fakefs && !(fd->mount->fs==&procfs && safe_proc(p)))return _ENOTSUP;
+    fd->workspace_job=current->session_job;fd->workspace_rights=rights(g,p)&(WP_READ|WP_WRITE);
+    for(unsigned i=0;i<g->count;i++)if(!strcmp(p,g->roots[i].path))fd->workspace_rights&=~WP_WRITE;
+    return 0;
+}
+int ish_workspace_fd(struct fd *fd,int access) {
+    if(!ish_workspace_current())return 0;
+    if(fd->mount && !is_adhoc_fd(fd)) {
+        return fd->workspace_job==current->session_job && (fd->workspace_rights&(unsigned)access)==(unsigned)access ? 0 : _EACCES;
+    }
+    // Anonymous objects created in the job, plus controller-provided pipe stdio.
+    if(fd->workspace_job==current->session_job)return 0;
+    struct stat st;
+    return fd->workspace_job==0 && fd->real_fd>=0 && fstat(fd->real_fd,&st)==0 && S_ISFIFO(st.st_mode) ? 0 : _EACCES;
+}
