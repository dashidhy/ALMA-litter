+#[derive(Debug,Clone,Copy)]
+pub enum WorkspaceNetworkPolicy { DenyDirect }
+
+/// Single-use, native-host-issued grant. Drop never forces reuse of a bound view:
+/// the kernel defers removal until the owned job has completed and been released.
+pub struct WorkspaceGrant { token: u32, instance: Weak<InstanceInner> }
+impl Drop for WorkspaceGrant {
+    fn drop(&mut self) { unsafe { ffi::ish_ffi_workspace_grant_release(self.token); } }
+}
+impl IshInstance {
+    pub fn prepare_workspace_grant(&self, read_roots: &[PathBuf], write_roots: &[PathBuf],
+        network: WorkspaceNetworkPolicy) -> Result<WorkspaceGrant,IshError> {
+        if !self.workspace_policy_enabled() { return Err(IshError::Supervisor("workspace policy is not ready".into())); }
+        let read=read_roots.iter().map(|p|CString::new(p.as_os_str().as_bytes())).collect::<Result<Vec<_>,_>>()
+            .map_err(|_|IshError::Supervisor("invalid read root".into()))?;
+        let write=write_roots.iter().map(|p|CString::new(p.as_os_str().as_bytes())).collect::<Result<Vec<_>,_>>()
+            .map_err(|_|IshError::Supervisor("invalid write root".into()))?;
+        let ro:Vec<_>=read.iter().map(|p|p.as_ptr()).collect();
+        let rw:Vec<_>=write.iter().map(|p|p.as_ptr()).collect();
+        let network=match network {WorkspaceNetworkPolicy::DenyDirect=>0};
+        let rc=unsafe {ffi::ish_ffi_workspace_grant_create(ro.as_ptr(),ro.len(),rw.as_ptr(),rw.len(),network)};
+        if rc<0 { return Err(IshError::KernelCall{call:"workspace_grant_create",rc}); }
+        Ok(WorkspaceGrant {token:rc as u32,instance:Arc::downgrade(&self.inner)})
+    }
+}
