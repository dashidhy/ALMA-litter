        "compact_failed",
        "compact_boundary",
        "session_compacted",
        "model_anomaly_warning",
        "model_error",
        "turn_error",
        "error",
        "model_selected",
        "turn_execution_model_fallback",
        "stream_recovery_started",
        "stream_recovery_retry_started",
        "stream_recovery_blocked",
        "permission_requested",
        "permission_resolved",
        "permission_denied",
        "interrupt",
        "cancel",
        "system_message"
      ]
    },
    {
      "handling": "sdk_owned",
      "reason": "Alma owns user admission and thread identity; SDK transport/bookkeeping, private model request/stream bodies, metrics, microcompaction and per-tool aggregate duplicates are not chat rows. Token streaming remains off.",
