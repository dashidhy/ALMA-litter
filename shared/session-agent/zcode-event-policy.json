        "stream_recovery_anchor_created",
        "stream_recovery_anchor_selected",
        "stream_recovery_tail_discarded",
        "network_request_status",
        "tool_batch_complete",
        "microcompact_boundary",
        "checkpoint_created",
        "resume"
      ]
    },
    {
      "handling": "disabled",
      "reason": "Current mobile profile does not expose fork, steer/queue, background tools, dynamic workflows, plugins, hooks, targets, rewind or subagents; no capabilities are enabled by this audit",
